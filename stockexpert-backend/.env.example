# Run python3 scripts/init_env.py to create .env with random values.
SECRET_KEY=GENERATE_WITH_INIT_ENV
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
MINIO_ACCESS_KEY=stockexpert
MINIO_SECRET_KEY=GENERATE_WITH_INIT_ENV
ADMIN_USERNAME=markov_f
ADMIN_PASSWORD=GENERATE_WITH_INIT_ENV
# Choose qwen3-8b for local processing, or deepseek after configuring its API key.
LLM_DEFAULT_PROFILE=qwen3-8b
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b-q4_K_M
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
LLM_CONCURRENCY=4
NORMALIZATION_MAX_ATTEMPTS=3
TAXONOMY_MAX_ATTEMPTS=3
OLLAMA_LLM_CONCURRENCY=1
OLLAMA_LLM_NUM_CTX=16384
OLLAMA_LLM_MAX_TOKENS=4096
OLLAMA_LLM_TIMEOUT=600
EMBEDDING_MODEL=bge-m3
RERANKER_ENABLED=true
